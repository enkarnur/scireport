{
  "name": "aime-plugin-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && python3 ../utils/cdn_build.py",
    "build:local": "pnpm run typecheck && vite build",
    "build:cdn": "pnpm run typecheck && vite build --mode cdn",
    "build:debug": "pnpm run typecheck && vite build --sourcemap"
  },
  "dependencies": {
    "@aime-plugin/browser-sdk": "0.1.10",
    "@arco-design/web-react": "^2.56.0",
    "@bytecloud/common-lib": "^7.53.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.4.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.12",
    "@tailwindcss/vite": "^4.0.12",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.0",
    "less": "^4.2.0",
    "tailwindcss": "^4.0.12",
    "typescript": "^5.8.2",
    "vite": "^6.0.0"
  }
}
